# LLM API Keys
# Policy (src/utils/llm_router.py): each use case prefers the best PREMIUM model whose
# key is set, and falls back to a FREE open-source model on OpenRouter otherwise. So the
# whole system runs on an OPENROUTER_API_KEY alone, and upgrades automatically as you add
# premium keys — no code change.
#   • OPENROUTER_API_KEY — start here (free open-source models: analysis, strategy, insights)
#   • ANTHROPIC_API_KEY  — Claude for market analysis (best quality)
#   • OPENAI_API_KEY     — embeddings for trade memory/insights + risk sizing
#   • GOOGLE_API_KEY     — Gemini (a.k.a. GEMINI_API_KEY)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_API_KEY=your_groq_key_here
GOOGLE_API_KEY=your_gemini_key_here

# Exchange API Keys
BINANCE_API_KEY=your_binance_key_here
BINANCE_SECRET_KEY=your_binance_secret_here
BINGX_API_KEY=your_bingx_key_here
BINGX_SECRET_KEY=your_bingx_secret_here

# Database
# For local (non-Docker) runs use localhost; for Docker Compose use the service
# names `redis` / `postgres` as hosts (see the Docker Compose section below).
REDIS_URL=redis://localhost:6379
# POSTGRES_URL: the trading DB. Two options —
#  (a) local/self-hosted:  postgresql://trader:CHANGE_ME@localhost:5432/trading_agent
#  (b) CONSOLIDATED on Supabase (recommended for SaaS — same DB as auth, enables
#      per-user tenancy; see docs/MULTI_TENANCY.md). Use the project's direct connection
#      string from Supabase → Project Settings → Database:
#        postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
POSTGRES_URL=postgresql://trader:CHANGE_ME@localhost:5432/trading_agent

# Vector Database
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENV=your_environment

# Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server Auth
# Multi-tenancy: set this to your Supabase project URL so the API verifies each
# logged-in user's Supabase access token (JWT) against the project's JWKS and scopes
# reads to that user. Same value as the frontend's NEXT_PUBLIC_SUPABASE_URL. When set,
# API reads require a valid user JWT (or the service API_AUTH_TOKEN below).
SUPABASE_URL=https://your-project.supabase.co
# Static SERVICE/admin token. When set, ALL non-health API endpoints and the /ws
# handshake accept `Authorization: Bearer <token>` as an unscoped service caller. When
# unset, the destructive /api/close-positions endpoint is hard-disabled (fail-closed)
# and the server binds to localhost only. User traffic uses the Supabase JWT above.
API_AUTH_TOKEN=
# Comma-separated allowed CORS origins for the dashboard (no wildcard with credentials).
API_CORS_ORIGINS=http://localhost:3000
# Host to bind the API server to. Keep 127.0.0.1 unless behind an authenticating proxy.
API_HOST=127.0.0.1
# Master key for the per-user exchange-key vault (encrypts stored API keys at rest).
# Generate once and keep STABLE (rotating it orphans stored ciphertext):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENC_KEY=

# Execution Configuration
EXCHANGE_NAME=bingx
USE_TESTNET=true
MAX_POSITION_SIZE=0.1
ENABLE_EXECUTION=false
# SAFETY GATE: real-money (mainnet, USE_TESTNET=false) live trading is refused unless this
# is set to "true". Only set it AFTER the live path is validated on BingX VST testnet.
LIVE_TRADING_CONFIRMED=false

# Multi-user daemon (src.multi_user_daemon). How often to run the shared analysis cycle.
CYCLE_INTERVAL=180
# Traded instruments (comma-separated). Default BTC + ETH + GOLD. Gold = XAUTUSDT
# (Tether Gold, 1 XAUT ≈ 1oz) — the crypto gold instrument on Binance/Bybit/OKX; a
# literal "XAUUSDT" pair isn't listed on crypto exchanges. Drives the data agent's
# subscriptions and the daemon's per-symbol analysis loop.
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,XAUTUSDT
# Optional DB pool tuning (defaults are production-sane).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800

# API rate limiting (per caller: user token if authed, else client IP; /health exempt).
# RATE_LIMIT_PER_MINUTE=240
# RATE_LIMIT_WRITE_PER_MINUTE=60
# WS_CONNECTIONS_PER_CLIENT=8

# External-call timeouts (seconds). Exchange REST + LLM calls are bounded so a hung
# provider fails fast instead of stalling the trading pipeline.
# EXCHANGE_HTTP_TIMEOUT=15
# EXCHANGE_CONNECT_TIMEOUT=5

# Error tracking — set a Sentry DSN to activate (no-op otherwise).
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# Optional: comma-separated Supabase user IDs the daemon ALWAYS trades (paper/demo),
# e.g. the owner's account for a populated demo. Real users are discovered from the
# encrypted vault automatically the moment they connect exchange keys.
MULTI_USER_SEED_IDS=

# Billing / subscription tiers (src/billing/plans.py). A user's tier sets their balance
# + risk limits. Until Stripe is wired, tiers come from env:
#   DEFAULT_PLAN_TIER: tier for everyone without an override (free | starter | pro)
#   PLAN_OVERRIDES:    JSON of per-user overrides, e.g. {"<user-uuid>":"pro"}
DEFAULT_PLAN_TIER=free
PLAN_OVERRIDES=

# ---------------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------------
# Consumed by docker-compose.yml. Postgres container init reads these (no defaults
# are baked in — they MUST be set). When running under Compose, also point the URLs
# above at the service hostnames, e.g.:
#   REDIS_URL=redis://redis:6379
#   POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_DB=trading_agent
POSTGRES_USER=trader
POSTGRES_PASSWORD=CHANGE_ME

# Optional pgAdmin UI (only started with `--profile tools`).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# Frontend public vars — inlined into the client bundle at BUILD time by the
# frontend image (passed as Docker build args by Compose).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_API_TOKEN=
