# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_API_KEY=your_groq_key_here

# Exchange API Keys
BINANCE_API_KEY=your_binance_key_here
BINANCE_SECRET_KEY=your_binance_secret_here
BINGX_API_KEY=your_bingx_key_here
BINGX_SECRET_KEY=your_bingx_secret_here

# Database
# For local (non-Docker) runs use localhost; for Docker Compose use the service
# names `redis` / `postgres` as hosts (see the Docker Compose section below).
REDIS_URL=redis://localhost:6379
# POSTGRES_URL: the trading DB. Two options —
#  (a) local/self-hosted:  postgresql://trader:CHANGE_ME@localhost:5432/trading_agent
#  (b) CONSOLIDATED on Supabase (recommended for SaaS — same DB as auth, enables
#      per-user tenancy; see docs/MULTI_TENANCY.md). Use the project's direct connection
#      string from Supabase → Project Settings → Database:
#        postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
POSTGRES_URL=postgresql://trader:CHANGE_ME@localhost:5432/trading_agent

# Vector Database
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENV=your_environment

# Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server Auth
# When set, ALL non-health API endpoints and the /ws handshake require
# `Authorization: Bearer <token>`. When unset, the destructive /api/close-positions
# endpoint is hard-disabled (fail-closed) and the server binds to localhost only.
API_AUTH_TOKEN=
# Comma-separated allowed CORS origins for the dashboard (no wildcard with credentials).
API_CORS_ORIGINS=http://localhost:3000
# Host to bind the API server to. Keep 127.0.0.1 unless behind an authenticating proxy.
API_HOST=127.0.0.1

# Execution Configuration
EXCHANGE_NAME=bingx
USE_TESTNET=true
MAX_POSITION_SIZE=0.1
ENABLE_EXECUTION=false
# SAFETY GATE: real-money (mainnet, USE_TESTNET=false) live trading is refused unless this
# is set to "true". Only set it AFTER the live path is validated on BingX VST testnet.
LIVE_TRADING_CONFIRMED=false

# ---------------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------------
# Consumed by docker-compose.yml. Postgres container init reads these (no defaults
# are baked in — they MUST be set). When running under Compose, also point the URLs
# above at the service hostnames, e.g.:
#   REDIS_URL=redis://redis:6379
#   POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_DB=trading_agent
POSTGRES_USER=trader
POSTGRES_PASSWORD=CHANGE_ME

# Optional pgAdmin UI (only started with `--profile tools`).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# Frontend public vars — inlined into the client bundle at BUILD time by the
# frontend image (passed as Docker build args by Compose).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_API_TOKEN=
