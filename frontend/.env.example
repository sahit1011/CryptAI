# Supabase (public — inlined into the client bundle at build time).
# Copy to .env.local and fill with your project's real values; the build needs these
# present to produce a working auth flow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API + WebSocket the dashboard talks to. Use wss:// / https:// in production
# (ws:// / http:// are blocked as mixed content on an https deployment).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Optional READ-ONLY bearer token for the backend when API_AUTH_TOKEN is set there.
# This IS bundled into client JS — use it ONLY for read-only GET requests and the
# WS handshake (appended as ?token= since browsers can't send Authorization on WS).
# NEVER put an admin / destructive-capable token here.
NEXT_PUBLIC_API_TOKEN=

# SERVER-ONLY admin secret for destructive actions (close-positions). No NEXT_PUBLIC_
# prefix => it is NOT bundled into client JS. The same-origin /api/close-positions
# Next route reads this and forwards to the backend. Leave empty to keep the
# destructive control disabled (the route fails closed with 503).
CRYPTAI_ADMIN_TOKEN=

# Optional: server-side backend URL override for Next route handlers. Falls back to
# NEXT_PUBLIC_API_URL when unset. Useful if the server reaches the backend on a
# different (internal) host than the browser does.
API_URL=
