# Supabase (public — inlined into the client bundle at build time).
# Copy to .env.local and fill with your project's real values; the build needs these
# present to produce a working auth flow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API + WebSocket the dashboard talks to. Use wss:// / https:// in production
# (ws:// / http:// are blocked as mixed content on an https deployment).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Optional: bearer token sent to the backend API/WS when API_AUTH_TOKEN is set there.
NEXT_PUBLIC_API_TOKEN=
